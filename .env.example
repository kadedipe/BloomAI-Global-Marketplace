ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./bloomai.sqlite3
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY_MINUTES=60
AUTH_COOKIE_NAME=bloomai_session
ENABLE_API_DOCS=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PRODUCT_IMAGE_MAX_BYTES=5000000
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/?payment=callback
PAYSTACK_CURRENCIES=NGN
RATE_LIMIT_ENABLED=true
VITE_API_URL=http://localhost:8000
VITE_AI_API_URL=http://localhost:8001
MODEL_PATH=/app/models/checkpoint.pth
DEPLOYED_APP_URL=https://bloomai-web-production.up.railway.app
DEMO_VIDEO_URL=
